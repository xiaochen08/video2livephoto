{
  "name": "video2livephoto-v1",
  "version": "1.0.0-candidate",
  "private": true,
  "description": "Windows desktop workflow for Video2LivePhoto M3",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build --mode demo",
    "build:desktop": "vue-tsc --noEmit -p tsconfig.json && vite build --mode desktop",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "dev:desktop": "vite --mode desktop",
    "dev": "vite",
    "package:win": "npm run build:desktop && electron-builder --win nsis",
    "selftest": "node scripts/selftest.mjs",
    "test": "npm run build && npm run selftest",
    "start": "electron ."
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.13"
  },
  "build": {
    "appId": "com.video2livephoto.v1",
    "productName": "Video2LivePhoto",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "delivery/v1.0/installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "app/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.12"
  }
}
